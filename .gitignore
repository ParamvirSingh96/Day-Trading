# ── Secrets ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── SQLite databases incl. WAL/SHM sidecars (anywhere in the tree) ───────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Backend/data: runtime state, caches, telemetry, research output ──────
# Everything here is generated at runtime or by research scripts and may
# contain broker order ids, cached (licensed) market data, or local paths.
Backend/data/*
!Backend/data/.gitkeep
!Backend/data/edge_lookup_v710.json

# ── One-off research/incident scripts kept locally, not published ───────
Backend/scripts/research_archive/

# ── Logs / telemetry anywhere ────────────────────────────────────────────
*.log
*.jsonl

# ── Machine-local tooling / editors ──────────────────────────────────────
.claude/settings.local.json
.claude/launch.json
.DS_Store
.idea/
.vscode/

# ── Node / build output ──────────────────────────────────────────────────
node_modules/
dist/
build/
