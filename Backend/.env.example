# TradeHack — backend configuration template
# Copy to Backend/.env and fill in your own values. Never commit .env.
#
# Defaults below are the SAFE posture: Alpaca PAPER account, live trading
# disabled, autonomous execution and scheduler auto-start opt-in only.

# ── App / web ───────────────────────────────────────────────────────────
APP_ENV=development
# Local development uses SQLite. With APP_ENV=production the server refuses
# to start unless this is a PostgreSQL URL.
DATABASE_URL=sqlite:///./data/tradehack-dev.db
# Comma-separated browser origins allowed to call the API (the frontend host).
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SESSION_COOKIE_NAME=tradehack_session
# Must be false for plain-http local development; set true behind HTTPS
# (required when APP_ENV=production).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800

# ── Alpaca (paper trading) ──────────────────────────────────────────────
# Create a PAPER key pair at https://app.alpaca.markets (paper account).
ALPACA_API_KEY=YOUR_ALPACA_PAPER_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_PAPER_SECRET
ALPACA_MARKET_DATA_URL=https://data.alpaca.markets/v2
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true
# Hard guard: anything other than "no" is refused by the settings loader
# unless every live-trading precondition is explicitly satisfied.
LIVE_TRADING_ENABLED=no
# Market-data feed: "sip" (consolidated tape, paid subscription) or "iex"
# (free). Bar caches are kept per feed so switching never mixes data.
ALPACA_DATA_FEED=iex

# ── Universe ────────────────────────────────────────────────────────────
TRAINING_UNIVERSE=AAPL,NVDA,AMD,TSLA,AMZN,MSFT,GOOGL,JPM,MS,INTC,SOFI,BAC,F,PLTR,SOXL,DKNG,XLF,XLE,ADBE,CRM,HD,UNH,XLV

# ── Scanner / execution gates ───────────────────────────────────────────
# Optional AI confidence gate (Claude pre-screen of predicate-confirmed
# setups). Off by default: the predicate scanner trades on its own.
ENABLE_AI_GATE=false
# Apply the scheduler-built morning universe automatically at 08:30 ET.
AUTO_APPLY_AFTER_BUILD=true
# Start the autotrade scanner automatically at 09:30 ET on weekdays
# (fail-closed: requires today's applied universe and the operator account
# below). Leave false until you have watched the build/apply automation.
AUTO_START_TRADING=false
# Email of the account the unattended scheduler trades under. Must match a
# registered user; the auto-start refuses to fire otherwise.
SCHEDULER_USER_EMAIL=
# Auto-approve and auto-execute setups that clear every gate (confidence
# floor, regime veto, duplicate/max-open checks, circuit breaker, sizing,
# paper-only). Boot default only — the dashboard "Autonomous" switch
# toggles it live. Opt-in.
AUTONOMOUS_TRADING_ENABLED=false
AUTONOMOUS_MAX_TRADES_PER_DAY=5

# ── Experimental scanner lane (paper-only; refused if paper mode is off) ──
EXPERIMENTAL_SCANNER_ENABLED=false
EXPERIMENTAL_MAX_TRADES_PER_DAY=1
EXPERIMENTAL_RISK_MULTIPLIER=0.25
EXPERIMENTAL_SCAN_TIMEOUT_SECONDS=2.0
EXPERIMENTAL_REQUIRE_SCANNER_ID=true

# ── Telemetry ───────────────────────────────────────────────────────────
# Persist broker fills so reported P&L is broker-true.
FILL_PERSIST_ENABLED=true
# Write per-trade dossiers to data/trade_exports/ (off on a single-operator box).
EXPORT_TRADES=false
FRIEND_INSTANCE_ID=

# ── Email alerts (optional) ─────────────────────────────────────────────
# Gmail app password: https://myaccount.google.com/apppasswords (needs
# 2-Step Verification). If SMTP_APP_PASSWORD is empty, alerts are logged
# and skipped — the scheduler keeps running.
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_TO=
SMTP_FROM=

# ── AI chart analysis (optional) ────────────────────────────────────────
ANTHROPIC_API_KEY=
# Fallback model used when the primary AI provider is overloaded.
OPENAI_API_KEY=
